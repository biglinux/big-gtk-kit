From ae3ac11b3afa96e71a5f512da65920e8984780b8 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Gon=C3=A7alves?= <bigbruno@gmail.com>
Date: Wed, 4 Nov 2026 22:10:16 -0300
Subject: [PATCH] Use gi18n-lib.h wherever strings are translated

With gi18n.h, _() and C_() look strings up in the default text domain,
which belongs to the application, so these strings were only translated
when the application's own catalog happened to contain the same string:
the accessible labels of the sheet close button, the avatar, the split
button menu and the indicator badges, the shortcut label side markers,
"No Shortcut" in shortcut rows, the toast announcements and the
inspector page.

Drop the include where nothing is translated.
---
 src/adw-avatar.c            | 2 +-
 src/adw-indicator-bin.c     | 2 +-
 src/adw-inspector-page.c    | 2 +-
 src/adw-sheet-controls.c    | 2 +-
 src/adw-shortcut-label.c    | 2 +-
 src/adw-shortcut-row.c      | 2 +-
 src/adw-shortcuts-section.c | 2 --
 src/adw-spinner-paintable.c | 1 -
 src/adw-spinner.c           | 1 -
 src/adw-split-button.c      | 2 +-
 src/adw-toast-overlay.c     | 2 +-
 11 files changed, 8 insertions(+), 12 deletions(-)

diff --git a/src/adw-avatar.c b/src/adw-avatar.c
index 831590c4..29131542 100644
--- a/src/adw-avatar.c
+++ b/src/adw-avatar.c
@@ -12,7 +12,7 @@
 
 #include "config.h"
 #include <math.h>
-#include <glib/gi18n.h>
+#include <glib/gi18n-lib.h>
 
 #include "adw-avatar.h"
 #include "adw-gizmo-private.h"
