 }
@@ -86,6 +88,7 @@ gsk_gpu_cached_fill_equal (gconstpointer v1,
 
   return fill1->fx == fill2->fx &&
          fill1->fy == fill2->fy &&
+         fill1->subpixel_scale == fill2->subpixel_scale &&
          fill1->path == fill2->path &&
          fill1->fill_rule == fill2->fill_rule &&
          fill1->sx == fill2->sx &&
@@ -173,12 +176,22 @@ determine_scale_and_subpixel_grid (const graphene_size_t *scale,
       *sy = exp2f (ceilf (log2f (scale->height)));
       *subpixel_scale = 1;
     }
-  else
+  else if (gsk_gpu_scale_is_step (scale->width) &&
+           gsk_gpu_scale_is_step (scale->height))
     {
       *sx = scale->width;
       *sy = scale->height;
       *subpixel_scale = 32;
     }
