--- a/gsk/gpu/gskgpucachedfill.c
+++ b/gsk/gpu/gskgpucachedfill.c
@@ -27,6 +27,7 @@ struct _GskGpuCachedFill
   GskPath *path;
   GskFillRule fill_rule;
   float sx, sy;
+  gsize subpixel_scale;
 
   /* Subpixel position of the path bounds wrt to device grid */
   guint fx, fy;
@@ -73,6 +74,7 @@ gsk_gpu_cached_fill_hash (gconstpointer data)
          (self->fill_rule) << 28 ^
          (((guint) (self->sx * 16)) << 16) ^
          ((guint) (self->sy * 16) << 8) ^
+         (((guint) self->subpixel_scale) << 24) ^
          (self->fx << 4) ^
