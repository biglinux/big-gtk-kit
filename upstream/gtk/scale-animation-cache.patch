@@ -213,6 +226,7 @@ gsk_gpu_cached_fill_lookup (GskGpuCache           *self,
                                   .sy = sy,
                                   .fx = fx,
                                   .fy = fy,
+                                  .subpixel_scale = subpixel_scale,
                                 });
   if (cached)
     {
@@ -229,7 +243,7 @@ gsk_gpu_cached_fill_lookup (GskGpuCache           *self,
 
   if (!gsk_path_get_bounds (path, &viewport) ||
       !gsk_rect_snap_to_grid_grow (&viewport,
-                                   scale,
+                                   &GRAPHENE_SIZE_INIT (sx, sy),
