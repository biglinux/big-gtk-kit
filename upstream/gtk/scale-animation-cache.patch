 }
 
+static void
+test_gl_renderer_scaled_text (void)
+{
+#ifdef GDK_RENDERING_GL
+  GdkDisplay *display;
+  GskRenderer *renderer;
+  GError *error = NULL;
+  PangoFontMap *fontmap;
+  PangoContext *context;
+  PangoLayout *layout;
+  PangoFontDescription *desc;
+  PangoGlyphItem *run;
+  PangoFont *font;
+  char *path;
+  GskRenderNode *text, *node;
+  GskTransform *transform;
+  GdkTexture *plain, *scaled;
+  guchar plain_data[40 * 30 * 4], scaled_data[40 * 30 * 4];
+
+  /* A display of its own, as test_renderer() uses: with Mesa, GL on the
+   * default display aborts once a display that used GL was closed */
+  display = gdk_display_open (NULL);
+  if (display == NULL)
+    {
+      g_test_skip ("Could not open a second display");
+      return;
+    }
+
+  renderer = gsk_gl_renderer_new ();
+  if (!gsk_renderer_realize_for_display (renderer, display, &error))
+    {
+      g_test_skip_printf ("GL renderer not available: %s", error->message);
+      g_clear_error (&error);
+      g_object_unref (renderer);
+      gdk_display_close (display);
+      return;
+    }
+
+  /* Only the test font, hinted as in the compare tests */
+  fontmap = pango_cairo_font_map_new ();
+#ifdef HAVE_PANGOFT
+  {
+    FcConfig *config;
+
+    config = FcConfigCreate ();
+    pango_fc_font_map_set_config (PANGO_FC_FONT_MAP (fontmap), config);
+    FcConfigDestroy (config);
+  }
+#endif
+  path = g_test_build_filename (G_TEST_DIST, "fonts", "Cantarell-VF.otf", NULL);
+  pango_font_map_add_font_file (fontmap, path, &error);
+  g_assert_no_error (error);
+  g_free (path);
+
+  context = pango_font_map_create_context (fontmap);
+  layout = pango_layout_new (context);
+  desc = pango_font_description_from_string ("Cantarell 15px");
+  pango_layout_set_font_description (layout, desc);
+  pango_font_description_free (desc);
+  pango_layout_set_text (layout, "Abc", -1);
+  run = pango_layout_get_line_readonly (layout, 0)->runs->data;
+  font = gsk_reload_font (run->item->analysis.font, 1.0, CAIRO_HINT_METRICS_OFF, CAIRO_HINT_STYLE_SLIGHT, CAIRO_ANTIALIAS_GRAY);
+  text = gsk_text_node_new (font, run->glyphs, &(GdkRGBA) { 0, 0, 0, 1 }, &GRAPHENE_POINT_INIT (0, 20));
+
+  /* Glyphs are rasterized at the nearest scale step and drawn pixel
+   * for pixel; this short text lands on the same pixels */
+  transform = gsk_transform_scale (NULL, 1.003, 1.003);
+  node = gsk_transform_node_new (text, transform);
+  gsk_transform_unref (transform);
+  plain = gsk_renderer_render_texture (renderer, text, &GRAPHENE_RECT_INIT (0, 0, 40, 30));
+  scaled = gsk_renderer_render_texture (renderer, node, &GRAPHENE_RECT_INIT (0, 0, 40, 30));
+  gdk_texture_download (plain, plain_data, 40 * 4);
+  gdk_texture_download (scaled, scaled_data, 40 * 4);
+  g_assert_cmpmem (plain_data, sizeof (plain_data), scaled_data, sizeof (scaled_data));
+
+  g_object_unref (scaled);
+  g_object_unref (plain);
+  gsk_render_node_unref (node);
+  gsk_render_node_unref (text);
+  g_object_unref (font);
+  g_object_unref (layout);
+  g_object_unref (context);
+  g_object_unref (fontmap);
+  gsk_renderer_unrealize (renderer);
+  g_object_unref (renderer);
+  gdk_display_close (display);
+#else
+  g_test_skip ("no GL support");
+#endif
+}
+
+#ifdef GDK_RENDERING_GL
+static void
+render_scaled_fill (GskRenderer *renderer,
+                    GskPath     *path,
+                    GskFillRule  fill_rule,
+                    float        scale,
+                    float        offset,
+                    guchar      *data)
+{
+  graphene_rect_t bounds;
+  GskRenderNode *color, *fill, *node;
+  GskTransform *transform;
+  GdkTexture *texture;
+
+  g_assert_true (gsk_path_get_bounds (path, &bounds));
+  color = gsk_color_node_new (&(GdkRGBA) { 0, 0, 0, 1 }, &bounds);
+  fill = gsk_fill_node_new (color, path, fill_rule);
+  transform = gsk_transform_scale (NULL, scale, scale);
+  transform = gsk_transform_translate (transform, &GRAPHENE_POINT_INIT (offset, offset));
+  node = gsk_transform_node_new (fill, transform);
+
+  texture = gsk_renderer_render_texture (renderer, node, &GRAPHENE_RECT_INIT (0, 0, 40, 40));
+  gdk_texture_download (texture, data, 40 * 4);
+
+  g_object_unref (texture);
+  gsk_render_node_unref (node);
+  gsk_transform_unref (transform);
+  gsk_render_node_unref (fill);
+  gsk_render_node_unref (color);
+}
+#endif
+
+static void
+test_gl_renderer_scaled_fill (void)
+{
+#ifdef GDK_RENDERING_GL
+  GdkDisplay *display;
+  GskRenderer *renderer;
+  GError *error = NULL;
+  GskPathBuilder *builder;
+  GskPath *path;
+  guchar data[40 * 40 * 4], reference[40 * 40 * 4];
+
+  /* A display of its own, as test_renderer() uses: with Mesa, GL on the
+   * default display aborts once a display that used GL was closed */
+  display = gdk_display_open (NULL);
+  if (display == NULL)
+    {
+      g_test_skip ("Could not open a second display");
+      return;
+    }
+
+  renderer = gsk_gl_renderer_new ();
+  if (!gsk_renderer_realize_for_display (renderer, display, &error))
+    {
+      g_test_skip_printf ("GL renderer not available: %s", error->message);
+      g_clear_error (&error);
+      g_object_unref (renderer);
+      gdk_display_close (display);
+      return;
+    }
+
+  builder = gsk_path_builder_new ();
+  gsk_path_builder_add_circle (builder, &GRAPHENE_POINT_INIT (15.25, 15.25), 10);
+  path = gsk_path_builder_free_to_path (builder);
+
+  /* Both scales cache their mask at the step above, 121/120, at the same
+   * quarter pixel phase: the mask must not depend on the frame that made
+   * it. The even-odd rule gives this circle the same coverage under a
+   * cache key of its own. */
+  render_scaled_fill (renderer, path, GSK_FILL_RULE_WINDING, 1.003, 0.375, data);
+  render_scaled_fill (renderer, path, GSK_FILL_RULE_WINDING, 1.006, 0.375, data);
+  render_scaled_fill (renderer, path, GSK_FILL_RULE_EVEN_ODD, 1.006, 0.375, reference);
+  g_assert_cmpmem (data, sizeof (data), reference, sizeof (reference));
+
+  /* At the step itself the phase is on a 1/32 pixel grid: 2/32 must not
+   * take the mask made for 2/4 */
+  render_scaled_fill (renderer, path, GSK_FILL_RULE_WINDING, 1.003, 0.625, data);
+  render_scaled_fill (renderer, path, GSK_FILL_RULE_WINDING, 121.f / 120, 0.07, data);
+  render_scaled_fill (renderer, path, GSK_FILL_RULE_EVEN_ODD, 121.f / 120, 0.07, reference);
+  g_assert_cmpmem (data, sizeof (data), reference, sizeof (reference));
+
+  gsk_path_unref (path);
+  gsk_renderer_unrealize (renderer);
+  g_object_unref (renderer);
+  gdk_display_close (display);
+#else
+  g_test_skip ("no GL support");
+#endif
+}
+
+static void
+test_gl_renderer_scaled_large_mask (void)
+{
+#ifdef GDK_RENDERING_GL
+  GdkDisplay *display;
+  GskRenderer *renderer;
+  GError *error = NULL;
+  GskPathBuilder *builder;
+  GskPath *path;
+  GskStroke *stroke;
+  GskRenderNode *color, *nodes[2];
+  GskTransform *transform;
+  /* 376 device pixels at 1.003, 378 mask pixels at 121/120 */
+  const float distance = 376 / 1.003f;
+  guchar data[400 * 16 * 4];
+
+  /* A display of its own, as test_renderer() uses: with Mesa, GL on the
+   * default display aborts once a display that used GL was closed */
+  display = gdk_display_open (NULL);
+  if (display == NULL)
+    {
+      g_test_skip ("Could not open a second display");
+      return;
+    }
+
+  renderer = gsk_gl_renderer_new ();
+  if (!gsk_renderer_realize_for_display (renderer, display, &error))
+    {
+      g_test_skip_printf ("GL renderer not available: %s", error->message);
+      g_clear_error (&error);
+      g_object_unref (renderer);
+      gdk_display_close (display);
+      return;
+    }
+
+  /* Two circles too far apart for the mask to fit in the atlas, at a
+   * whole number of pixels on the screen and in the mask: the uncached
+   * mask must draw both the same */
+  builder = gsk_path_builder_new ();
+  gsk_path_builder_add_circle (builder, &GRAPHENE_POINT_INIT (8.3, 8), 5);
+  gsk_path_builder_add_circle (builder, &GRAPHENE_POINT_INIT (8.3 + distance, 8), 5);
+  path = gsk_path_builder_free_to_path (builder);
+  stroke = gsk_stroke_new (1.5);
+
+  color = gsk_color_node_new (&(GdkRGBA) { 0, 0, 0, 1 }, &GRAPHENE_RECT_INIT (0, 0, 400, 16));
+  nodes[0] = gsk_fill_node_new (color, path, GSK_FILL_RULE_WINDING);
+  nodes[1] = gsk_stroke_node_new (color, path, stroke);
+  transform = gsk_transform_scale (NULL, 1.003, 1.003);
+
+  for (guint i = 0; i < G_N_ELEMENTS (nodes); i++)
+    {
+      GskRenderNode *node;
+      GdkTexture *texture;
+
+      node = gsk_transform_node_new (nodes[i], transform);
+      texture = gsk_renderer_render_texture (renderer, node, &GRAPHENE_RECT_INIT (0, 0, 400, 16));
+      gdk_texture_download (texture, data, 400 * 4);
+
+      for (guint y = 0; y < 16; y++)
+        for (guint x = 0; x < 16 * 4; x++)
+          g_assert_cmpint (ABS (data[y * 400 * 4 + x] - data[(y * 400 + 376) * 4 + x]), <=, 2);
+
+      g_object_unref (texture);
+      gsk_render_node_unref (node);
+    }
+
+  gsk_transform_unref (transform);
+  gsk_render_node_unref (nodes[1]);
+  gsk_render_node_unref (nodes[0]);
+  gsk_render_node_unref (color);
+  gsk_stroke_free (stroke);
+  gsk_path_unref (path);
+  gsk_renderer_unrealize (renderer);
+  g_object_unref (renderer);
+  gdk_display_close (display);
+#else
+  g_test_skip ("no GL support");
+#endif
+}
