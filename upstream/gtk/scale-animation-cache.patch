From b4b50f736d85ad4344cb97df5a415379e0745d5d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bruno=20Gon=C3=A7alves?= <bigbruno@gmail.com>
Date: Sun, 8 Nov 2026 23:52:04 -0300
Subject: [PATCH] gpu: Share cached glyphs and masks between nearby scales

Glyphs, fills and strokes are cached at the exact scale they are drawn
at. A scale animation draws at a new scale in every frame, so opening a
libadwaita dialog caches a new set of glyphs and masks per frame: after
200 openings of an About dialog the cache held 16 061 to 17 590 glyphs
in 9 or 10 atlases.

Output scales are multiples of 1/120. Between two of them, rasterize
glyphs at the nearest one and draw them pixel for pixel, so text stays
sharp, and render fills and strokes at the next one up on a quarter
pixel grid, so the frames of an animation share them. A scale on a
multiple of 1/120 is drawn as before.
---
 gsk/gpu/gskgpucachedfill.c    | 12 ++++-
 gsk/gpu/gskgpucachedstroke.c  | 12 ++++-
 gsk/gpu/gskgpunodeprocessor.c | 32 +++++++++----
 gsk/gpu/gskgpuutilsprivate.h  | 23 +++++++++
 testsuite/gsk/misc.c          | 90 +++++++++++++++++++++++++++++++++++
 5 files changed, 157 insertions(+), 12 deletions(-)

diff --git a/gsk/gpu/gskgpucachedfill.c b/gsk/gpu/gskgpucachedfill.c
index b3fe610f80..d816eff40f 100644
--- a/gsk/gpu/gskgpucachedfill.c
+++ b/gsk/gpu/gskgpucachedfill.c
@@ -173,12 +173,22 @@ determine_scale_and_subpixel_grid (const graphene_size_t *scale,
       *sy = exp2f (ceilf (log2f (scale->height)));
       *subpixel_scale = 1;
     }
-  else
+  else if (gsk_gpu_scale_is_step (scale->width) &&
+           gsk_gpu_scale_is_step (scale->height))
     {
       *sx = scale->width;
       *sy = scale->height;
       *subpixel_scale = 32;
     }
+  else
+    {
+      /* Between two scale steps, as in the frames of a scale animation,
+       * round up to the next step on a quarter pixel grid, so those
+       * frames share masks. */
+      *sx = gsk_gpu_scale_ceil_to_step (scale->width);
+      *sy = gsk_gpu_scale_ceil_to_step (scale->height);
+      *subpixel_scale = 4;
+    }
 }
 
 GskGpuImage *
diff --git a/gsk/gpu/gskgpucachedstroke.c b/gsk/gpu/gskgpucachedstroke.c
index 74b1c653bc..314a33a82d 100644
--- a/gsk/gpu/gskgpucachedstroke.c
+++ b/gsk/gpu/gskgpucachedstroke.c
@@ -184,12 +184,22 @@ determine_scale_and_subpixel_grid (const graphene_size_t *scale,
       *sy = exp2f (ceilf (log2f (scale->height)));
       *subpixel_scale = 1;
     }
-  else
+  else if (gsk_gpu_scale_is_step (scale->width) &&
+           gsk_gpu_scale_is_step (scale->height))
     {
       *sx = scale->width;
       *sy = scale->height;
       *subpixel_scale = 32;
     }
+  else
+    {
+      /* Between two scale steps, as in the frames of a scale animation,
+       * round up to the next step on a quarter pixel grid, so those
+       * frames share masks. */
+      *sx = gsk_gpu_scale_ceil_to_step (scale->width);
+      *sy = gsk_gpu_scale_ceil_to_step (scale->height);
+      *subpixel_scale = 4;
+    }
 }
 
 GskGpuImage *
diff --git a/gsk/gpu/gskgpunodeprocessor.c b/gsk/gpu/gskgpunodeprocessor.c
index c5bb9e3a32..f549b34b70 100644
--- a/gsk/gpu/gskgpunodeprocessor.c
+++ b/gsk/gpu/gskgpunodeprocessor.c
@@ -2613,7 +2613,7 @@ gsk_gpu_node_processor_add_glyph_node (GskGpuRenderPass *self,
   PangoFont *font;
   graphene_point_t offset;
   guint num_glyphs;
-  float scale;
+  float scale, glyph_scale;
   float align_scale_x, align_scale_y;
   unsigned int flags_mask;
   const float pango_scale = PANGO_SCALE;
@@ -2645,19 +2645,31 @@ gsk_gpu_node_processor_add_glyph_node (GskGpuRenderPass *self,
   if (gsk_transform_get_fine_category (self->modelview) <= GSK_FINE_TRANSFORM_CATEGORY_2D)
     {
       scale = exp2f (ceilf (log2f (scale)));
+      glyph_scale = scale;
       align_scale_x = align_scale_y = 1;
       flags_mask = 0;
     }
-  else if (hint_style != CAIRO_HINT_STYLE_NONE)
-    {
-      align_scale_x = scale * 4;
-      align_scale_y = scale;
-      flags_mask = 3;
-    }
   else
     {
-      align_scale_x = align_scale_y = scale * 4;
-      flags_mask = 15;
+      /* Between two scale steps, as in the frames of a scale animation,
+       * rasterize at the nearest step, so those frames share glyphs, and
+       * draw pixel for pixel, so text stays sharp. */
+      if (gsk_gpu_scale_is_step (scale))
+        glyph_scale = scale;
+      else
+        glyph_scale = gsk_gpu_scale_round_to_step (scale);
+
+      if (hint_style != CAIRO_HINT_STYLE_NONE)
+        {
+          align_scale_x = scale * 4;
+          align_scale_y = scale;
+          flags_mask = 3;
+        }
+      else
+        {
+          align_scale_x = align_scale_y = scale * 4;
+          flags_mask = 15;
+        }
     }
 
   for (guint i = 0; i < num_glyphs; i++)
@@ -2681,7 +2693,7 @@ gsk_gpu_node_processor_add_glyph_node (GskGpuRenderPass *self,
                                            font,
                                            glyphs[i].glyph,
                                            flags,
-                                           scale,
+                                           glyph_scale,
                                            &glyph_bounds,
                                            &glyph_offset);
 
diff --git a/gsk/gpu/gskgpuutilsprivate.h b/gsk/gpu/gskgpuutilsprivate.h
index 42c3410a46..d3695283cc 100644
--- a/gsk/gpu/gskgpuutilsprivate.h
+++ b/gsk/gpu/gskgpuutilsprivate.h
@@ -3,6 +3,11 @@
 #include "gskgputypesprivate.h"
 #include "gskrendernodeprivate.h"
 
+#include <math.h>
+
+/* Output scales come in steps of 1/120 (wp_fractional_scale_v1) */
+#define GSK_GPU_SCALE_STEPS 120
+
 GskGpuConversion        gsk_gpu_color_state_get_conversion              (GdkColorState                  *color_state);
 GdkColorState *         gsk_gpu_color_state_apply_conversion            (GdkColorState                  *color_state,
                                                                          GskGpuConversion                conversion);
@@ -21,3 +26,21 @@ gsk_gpu_mipmap_levels (gsize width,
 {
   return g_bit_nth_msf (MAX (width, height), -1) + 1;
 }
+
+static inline gboolean
+gsk_gpu_scale_is_step (float scale)
+{
+  return fabsf (scale * GSK_GPU_SCALE_STEPS - roundf (scale * GSK_GPU_SCALE_STEPS)) < 0.001f;
+}
+
+static inline float
+gsk_gpu_scale_round_to_step (float scale)
+{
+  return MAX (roundf (scale * GSK_GPU_SCALE_STEPS), 1) / GSK_GPU_SCALE_STEPS;
+}
+
+static inline float
+gsk_gpu_scale_ceil_to_step (float scale)
+{
+  return MAX (ceilf (scale * GSK_GPU_SCALE_STEPS - 0.001f), 1) / GSK_GPU_SCALE_STEPS;
+}
diff --git a/testsuite/gsk/misc.c b/testsuite/gsk/misc.c
index a1dc9c8274..3bee600c02 100644
--- a/testsuite/gsk/misc.c
+++ b/testsuite/gsk/misc.c
@@ -1,11 +1,18 @@
+#include "config.h"
+
 #include <gtk/gtk.h>
 #include "gsk/gskcontainernodeprivate.h"
 #include "gsk/gskbordernodeprivate.h"
 #include "gsk/gskgradientprivate.h"
 #include "gsk/gskradialgradientnodeprivate.h"
+#include "gsk/gskprivate.h"
 
 #include <gobject/gvaluecollector.h>
 
+#ifdef HAVE_PANGOFT
+#include <pango/pangofc-fontmap.h>
+#endif
+
 static void
 test_rendernode_gvalue (void)
 {
@@ -224,6 +231,88 @@ test_gl_renderer (void)
 #endif
 }
 
+static void
+test_gl_renderer_scaled_text (void)
+{
+#ifdef GDK_RENDERING_GL
+  GdkDisplay *display;
+  GskRenderer *renderer;
+  GError *error = NULL;
+  PangoFontMap *fontmap;
+  PangoContext *context;
+  PangoLayout *layout;
+  PangoFontDescription *desc;
+  PangoGlyphItem *run;
+  PangoFont *font;
+  char *path;
+  GskRenderNode *text, *node;
+  GdkTexture *plain, *scaled;
+  guchar plain_data[40 * 30 * 4], scaled_data[40 * 30 * 4];
+
+  /* A display of its own, as test_renderer() uses: with Mesa, GL on the
+   * default display aborts once a display that used GL was closed */
+  display = gdk_display_open (NULL);
+  renderer = gsk_gl_renderer_new ();
+  if (!gsk_renderer_realize_for_display (renderer, display, &error))
+    {
+      g_test_skip_printf ("GL renderer not available: %s", error->message);
+      g_clear_error (&error);
+      g_object_unref (renderer);
+      gdk_display_close (display);
+      return;
+    }
+
+  /* Only the test font, hinted as in the compare tests */
+  fontmap = pango_cairo_font_map_new ();
+#ifdef HAVE_PANGOFT
+  {
+    FcConfig *config;
+
+    config = FcConfigCreate ();
+    pango_fc_font_map_set_config (PANGO_FC_FONT_MAP (fontmap), config);
+    FcConfigDestroy (config);
+  }
+#endif
+  path = g_test_build_filename (G_TEST_DIST, "fonts", "Cantarell-VF.otf", NULL);
+  pango_font_map_add_font_file (fontmap, path, &error);
+  g_assert_no_error (error);
+  g_free (path);
+
+  context = pango_font_map_create_context (fontmap);
+  layout = pango_layout_new (context);
+  desc = pango_font_description_from_string ("Cantarell 15px");
+  pango_layout_set_font_description (layout, desc);
+  pango_font_description_free (desc);
+  pango_layout_set_text (layout, "Abc", -1);
+  run = pango_layout_get_line_readonly (layout, 0)->runs->data;
+  font = gsk_reload_font (run->item->analysis.font, 1.0, CAIRO_HINT_METRICS_OFF, CAIRO_HINT_STYLE_SLIGHT, CAIRO_ANTIALIAS_GRAY);
+  text = gsk_text_node_new (font, run->glyphs, &(GdkRGBA) { 0, 0, 0, 1 }, &GRAPHENE_POINT_INIT (0, 20));
+
+  /* Glyphs are rasterized at the nearest scale step and drawn pixel
+   * for pixel; this short text lands on the same pixels */
+  node = gsk_transform_node_new (text, gsk_transform_scale (NULL, 1.003, 1.003));
+  plain = gsk_renderer_render_texture (renderer, text, &GRAPHENE_RECT_INIT (0, 0, 40, 30));
+  scaled = gsk_renderer_render_texture (renderer, node, &GRAPHENE_RECT_INIT (0, 0, 40, 30));
+  gdk_texture_download (plain, plain_data, 40 * 4);
+  gdk_texture_download (scaled, scaled_data, 40 * 4);
+  g_assert_cmpmem (plain_data, sizeof (plain_data), scaled_data, sizeof (scaled_data));
+
+  g_object_unref (scaled);
+  g_object_unref (plain);
+  gsk_render_node_unref (node);
+  gsk_render_node_unref (text);
+  g_object_unref (font);
+  g_object_unref (layout);
+  g_object_unref (context);
+  g_object_unref (fontmap);
+  gsk_renderer_unrealize (renderer);
+  g_object_unref (renderer);
+  gdk_display_close (display);
+#else
+  g_test_skip ("no GL support");
+#endif
+}
+
 static void
 test_vulkan_renderer (void)
 {
@@ -336,6 +425,7 @@ main (int argc, char *argv[])
   g_test_add_func ("/rendernode/container/disjoint", test_container_disjoint);
   g_test_add_func ("/renderer/cairo", test_cairo_renderer);
   g_test_add_func ("/renderer/gl", test_gl_renderer);
+  g_test_add_func ("/renderer/gl/scaled-text", test_gl_renderer_scaled_text);
   g_test_add_func ("/renderer/vulkan", test_vulkan_renderer);
   g_test_add_func ("/gradient/opaque", test_gradient_opaque);
   g_test_add_func ("/rendernode/radial-gradient/opaque", test_radial_gradient_opaque);
