diff --git a/testsuite/gtk/cache-icon-themes.py b/testsuite/gtk/cache-icon-themes.py
new file mode 100755
index 0000000000..60bec8f3c6
--- /dev/null
+++ b/testsuite/gtk/cache-icon-themes.py
@@ -0,0 +1,29 @@
+#!/usr/bin/env python3
+#
+# Copy the icontheme test themes and give each an icon-theme.cache
+#
+# Usage: cache-icon-themes UPDATE-ICON-CACHE SOURCE-DIR OUTPUT-DIR
+#
+# The cache of the icons theme also lists 16x16/cache-only.png, which is
+# removed once the cache is written, so only a lookup in the cache finds it.
+
+import os
+import shutil
+import subprocess
+import sys
+
+update_icon_cache, srcdir, outdir = sys.argv[1:]
+
+shutil.rmtree(outdir, ignore_errors=True)
+
+for theme in ['icons', 'icons2']:
+    shutil.copytree(os.path.join(srcdir, theme), os.path.join(outdir, theme))
+
+icons16 = os.path.join(outdir, 'icons', '16x16')
+shutil.copyfile(os.path.join(icons16, 'simple.png'), os.path.join(icons16, 'cache-only.png'))
+
+for theme in ['icons', 'icons2']:
+    subprocess.run([update_icon_cache, '--quiet', os.path.join(outdir, theme)], check=True)
+
+# The cache stays valid: it is checked against the theme directory, not 16x16
+os.remove(os.path.join(icons16, 'cache-only.png'))
