+/* Returns whether any cache of @theme has the icon */
+static gboolean
+theme_find_in_caches (IconTheme         *theme,
+                      const char        *icon_name,
+                      GtkIconCacheEntry *entries)
+{
+  gboolean found = FALSE;
+
+  for (guint i = 0; i < theme->caches->len; i++)
+    {
+      gtk_icon_cache_find_icon (g_ptr_array_index (theme->caches, i), icon_name, &entries[i]);
+      found |= entries[i].plain != 0 || entries[i].symbolic != 0;
+    }
+
+  return found;
+}
+
+/* Finds the first directory of @dir_size that has the icon,
+ * @interned_name in icon_hash or @entries in cached_dirs.
+ */
+static gboolean
+theme_dir_size_find (IconTheme               *theme,
+                     IconThemeDirSize        *dir_size,
+                     const char              *interned_name,
+                     const GtkIconCacheEntry *entries,
+                     guint                   *dir_index,
+                     IconCacheFlag           *suffix)
+{
+  IconThemeFile *file = NULL;
+  gpointer file_index;
+
+  if (interned_name &&
+      g_hash_table_lookup_extended (dir_size->icon_hash, interned_name, NULL, &file_index))
+    file = &g_array_index (dir_size->icon_files, IconThemeFile, GPOINTER_TO_INT (file_index));
+
+  for (guint i = 0; i < dir_size->cached_dirs->len; i++)
+    {
+      IconThemeCachedDir *dir = &g_array_index (dir_size->cached_dirs, IconThemeCachedDir, i);
+      const GtkIconCacheEntry *entry = &entries[dir->cache_index];
+      guint flags;
+
+      if (file && file->dir_index < dir->dir_index)
+        break;
+
+      if (entry->plain == 0 && entry->symbolic == 0)
+        continue;
+
+      flags = gtk_icon_cache_get_icon_flags (g_ptr_array_index (theme->caches, dir->cache_index),
+                                             entry, dir->directory_index);
+      if (flags != 0)
+        {
+          *dir_index = dir->dir_index;
+          *suffix = best_suffix (flags);
+          return TRUE;
+        }
+    }
+
+  if (file)
+    {
+      *dir_index = file->dir_index;
+      *suffix = file->best_suffix;
+      return TRUE;
+    }
+
+  return FALSE;
+}
+
+static gboolean
+theme_has_icon (IconTheme  *theme,
+                const char *icon_name,
+                const char *interned_name)
+{
+  GtkIconCacheEntry *entries = g_newa (GtkIconCacheEntry, theme->caches->len + 1);
+  guint dir_index;
+  IconCacheFlag suffix;
+
+  if (!theme_find_in_caches (theme, icon_name, entries) && interned_name == NULL)
+    return FALSE;
+
+  for (guint i = 0; i < theme->dir_sizes->len; i++)
+    {
+      if (theme_dir_size_find (theme, &g_array_index (theme->dir_sizes, IconThemeDirSize, i),
+                               interned_name, entries, &dir_index, &suffix))
+        return TRUE;
+    }
+
+  return FALSE;
+}
