+/* The hash of gtk4-update-icon-cache, continued from @h over @name */
+static guint32
+icon_name_hash (guint32     h,
+                const char *name)
+{
+  for (const signed char *p = (const signed char *) name; *p != '\0'; p++)
+    h = (h << 5) - h + *p;
+
+  return h;
+}
+
+static guint32
+find_image_list (GtkIconCache *cache,
+                 guint32       hash,
+                 const char   *name,
+                 gsize         name_len,
+                 const char   *suffix)
+{
+  guint32 hash_offset, n_buckets, chain_offset;
+
+  hash_offset = GET_UINT32 (cache->buffer, 4);
+  n_buckets = GET_UINT32 (cache->buffer, hash_offset);
+  if (n_buckets == 0)
+    return 0;
+
+  chain_offset = GET_UINT32 (cache->buffer, hash_offset + 4 + 4 * (hash % n_buckets));
+  while (chain_offset != 0xffffffff)
+    {
+      const char *chain_name = cache->buffer + GET_UINT32 (cache->buffer, chain_offset + 4);
+
+      if (strncmp (chain_name, name, name_len) == 0 &&
+          strcmp (chain_name + name_len, suffix) == 0)
+        return GET_UINT32 (cache->buffer, chain_offset + 8);
+
+      chain_offset = GET_UINT32 (cache->buffer, chain_offset);
+    }
+
+  return 0;
+}
+
+static guint
+image_list_get_flags (GtkIconCache *cache,
+                      guint32       image_list_offset,
+                      int           directory_index)
+{
+  guint32 n_images, i;
+
+  if (image_list_offset == 0)
+    return 0;
+
+  n_images = GET_UINT32 (cache->buffer, image_list_offset);
+  for (i = 0; i < n_images; i++)
+    {
+      if (GET_UINT16 (cache->buffer, image_list_offset + 4 + 8 * i) == directory_index)
+        return GET_UINT16 (cache->buffer, image_list_offset + 4 + 8 * i + 2);
+    }
+
+  return 0;
+}
+
+void
+gtk_icon_cache_find_icon (GtkIconCache      *cache,
+                          const char        *icon_name,
+                          GtkIconCacheEntry *entry)
+{
+  guint32 hash = icon_name_hash (0, icon_name);
+  gsize len = strlen (icon_name);
+
+  entry->plain = find_image_list (cache, hash, icon_name, len, "");
+  entry->symbolic = find_image_list (cache, icon_name_hash (hash, ".symbolic"), icon_name, len, ".symbolic");
+  entry->is_symbolic_name = g_str_has_suffix (icon_name, ".symbolic");
+}
+
+/* Returns the flags gtk_icon_cache_list_icons_in_directory() lists
+ * for the icon of @entry in @directory_index, 0 if it is not there.
+ */
+guint
+gtk_icon_cache_get_icon_flags (GtkIconCache            *cache,
+                               const GtkIconCacheEntry *entry,
+                               int                      directory_index)
+{
+  guint flags, symbolic_flags;
+
+  flags = image_list_get_flags (cache, entry->plain, directory_index);
+  /* Listed under the name without ".symbolic" */
+  if (entry->is_symbolic_name && (flags & ICON_CACHE_FLAG_PNG_SUFFIX) != 0)
+    flags = 0;
+
+  symbolic_flags = image_list_get_flags (cache, entry->symbolic, directory_index);
+  if ((symbolic_flags & ICON_CACHE_FLAG_PNG_SUFFIX) != 0)
+    flags |= (symbolic_flags & ~ICON_CACHE_FLAG_PNG_SUFFIX) | ICON_CACHE_FLAG_SYMBOLIC_PNG_SUFFIX;
+
+  return flags;
+}
+
 GHashTable *
 gtk_icon_cache_list_icons_in_directory (GtkIconCache *cache,
-                                        const char   *directory,
+                                        int           directory_index,
                                         GtkStringSet *set)
 {
-  int directory_index;
   guint32 hash_offset, n_buckets;
   guint32 chain_offset;
   guint32 image_list_offset, n_images;
