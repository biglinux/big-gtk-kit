   GHashTable *icons = NULL;
   GString *string;
 
-  directory_index = get_directory_index (cache, directory);
-
-  if (directory_index == -1)
-    return NULL;
-
   hash_offset = GET_UINT32 (cache->buffer, 4);
   n_buckets = GET_UINT32 (cache->buffer, hash_offset);
 
