+static void
+test_cache (void)
+{
+  GtkIconTheme *theme;
+  char *cache;
+  char **icons;
+
+  cache = g_test_build_filename (G_TEST_DIST, "icons", "icon-theme.cache", NULL);
+  if (!g_file_test (cache, G_FILE_TEST_EXISTS))
+    {
+      g_test_skip ("The test theme has no icon-theme.cache");
+      g_free (cache);
+      return;
+    }
+  g_free (cache);
+
+  /* The cache lists 16x16/cache-only.png, which is not on disk */
+  theme = get_test_icontheme (TRUE);
+  g_assert_true (gtk_icon_theme_has_icon (theme, "cache-only"));
+  icons = gtk_icon_theme_get_icon_names (theme);
+  g_assert_true (g_strv_contains ((const char * const *) icons, "cache-only"));
+  g_strfreev (icons);
+  assert_icon_lookup ("cache-only", 16, GTK_TEXT_DIR_NONE, 0, FALSE,
+                      "/icons/16x16/cache-only.png");
+}
